<?xml version="1.0" encoding="utf-8"?>
<!-- Pin restore to nuget.org so the build is reproducible on any machine,
     regardless of whatever package sources a developer's environment adds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
