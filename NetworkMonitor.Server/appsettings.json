{
  "ConnectionStrings": {
    "Default": "Data Source=networkmonitor.db"
  },
  "Database": {
    "Provider": "sqlite"
  },
  "Scanning": {
    "NmapPath": "",
    "TempDirectory": "",
    "SchedulerEnabled": false,
    "SchedulerTickSeconds": 60,
    "MaxTargetAddresses": 65536
  },
  "Alerts": {
    "OfflineAfterMissedScans": 3,
    "CertExpiryWarningDays": 30,
    "InterfaceSaturationPercent": 85
  },
  "Demo": {
    "SeedOnFirstRun": true,
    "CompanyName": "Northwind Logistics"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
